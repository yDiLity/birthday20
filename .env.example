# Токен от @BotFather
BOT_TOKEN=

# Твой Telegram ID (админка работает только для него)
ADMIN_ID=

# Несколько админов через запятую (необязательно)
ADMIN_IDS=

# Telegram ID именинника. Если пусто — игру может запустить любой, кто напишет /start
HERO_ID=

# Имя именинника для текстов
HERO_NAME=Имя именинника

# Разрешить перезапуск игры после финала: true / false
ALLOW_RESTART=true

# Сколько дней хранить сессию (Redis TTL)
SESSION_TTL_DAYS=7

# Upstash Redis: обе переменные обязательны вместе
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Публичный адрес функции для webhook, например https://my-bot.vercel.app/api/telegram
WEBHOOK_URL=
